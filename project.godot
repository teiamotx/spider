; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Spider Swing"
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
; Renders at the 1280x720 design size and scales up, which is much cheaper on high-density phone screens.
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[physics]

; Smooths the player and camera on 90 and 120 Hz phone screens.
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
; The mobile renderer and Android export need ETC2/ASTC texture compression.
textures/vram_compression/import_etc2_astc=true

[input_devices]

; Lets mouse clicks act as single touches in the editor, for testing the on-screen controls.
pointing/emulate_touch_from_mouse=true
